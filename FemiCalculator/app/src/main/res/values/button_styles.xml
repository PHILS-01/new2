<resources>
    <style name="CalcButtonImageBase">
        <item name="android:layout_width">0dp</item><item name="android:layout_weight">1</item>
        <item name="android:layout_height">match_parent</item><item name="android:layout_margin">2dp</item>
        <item name="android:minWidth">0dp</item><item name="android:minHeight">0dp</item>
        <item name="android:padding">1dp</item><item name="android:textSize">16sp</item>
        <item name="android:textColor">#F5F5F5</item><item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item><item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="CalcButtonImageDark" parent="CalcButtonImageBase"><item name="android:background">@drawable/calc_button_dark</item></style>
    <style name="CalcButtonImageGreen" parent="CalcButtonImageBase"><item name="android:background">@drawable/calc_button_green</item><item name="android:textColor">#000000</item></style>
    <style name="CalcButtonImageOrange" parent="CalcButtonImageBase"><item name="android:background">@drawable/calc_button_orange</item><item name="android:textColor">#000000</item></style>
    <style name="CalcButtonImageLightGreen" parent="CalcButtonImageBase"><item name="android:background">@drawable/calc_button_lightgreen</item><item name="android:textColor">#235A2B</item><item name="android:textSize">15sp</item></style>
    <style name="CalcButtonImageGray" parent="CalcButtonImageBase"><item name="android:background">@drawable/calc_button_gray</item></style>
    <style name="CalcButtonImageGrayWide" parent="CalcButtonImageBase"><item name="android:background">@drawable/calc_button_gray</item><item name="android:textSize">18sp</item></style>
    <style name="CalcButtonImageYellow" parent="CalcButtonImageBase"><item name="android:background">@drawable/calc_button_yellow</item><item name="android:textColor">#555555</item><item name="android:textSize">26sp</item></style>
</resources>
