<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#101010" android:padding="4dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/btnDeg" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|start" android:paddingStart="16dp" android:text="DEG" android:textColor="#FF9800" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:id="@+id/txtMemory" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|end" android:paddingEnd="16dp" android:textColor="#AAAAAA" android:textSize="18sp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="104dp" android:orientation="vertical" android:paddingHorizontal="8dp">
        <TextView android:id="@+id/txtExpression" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical|end" android:textColor="#BDBDBD" android:textSize="19sp" android:singleLine="true"/>
        <TextView android:id="@+id/txtResult" android:layout_width="match_parent" android:layout_height="62dp" android:gravity="center_vertical|end" android:text="0" android:textColor="#F5F5F5" android:textSize="38sp" android:textStyle="bold" android:singleLine="true"/>
        <TextView android:id="@+id/txtDetailsLink" android:layout_width="wrap_content" android:layout_height="0dp" android:visibility="gone"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:orientation="horizontal">
        <Button android:id="@+id/btnShift" style="@style/CalcButtonImageGreen" android:text="SHIFT"/>
        <Button android:id="@+id/btnMenu" style="@style/CalcButtonImageDark" android:text="MENU"/>
        <Button android:id="@+id/btnLeft" style="@style/CalcButtonImageDark" android:text="◀"/>
        <Button android:id="@+id/btnRight" style="@style/CalcButtonImageDark" android:text="▶"/>
        <Button android:id="@+id/btnDel" style="@style/CalcButtonImageOrange" android:text="DEL"/>
        <Button android:id="@+id/btnClear" style="@style/CalcButtonImageOrange" android:text="AC"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:orientation="horizontal">
        <Button android:id="@+id/navStatistics" style="@style/CalcButtonImageLightGreen" android:text="STATISTICS"/>
        <Button android:id="@+id/navMatrices" style="@style/CalcButtonImageLightGreen" android:text="MATRICES"/>
        <Button android:id="@+id/navScience" style="@style/CalcButtonImageLightGreen" android:text="SCIENCE"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:orientation="horizontal">
        <Button android:id="@+id/btnDrg" style="@style/CalcButtonImageDark" android:text="DRG"/>
        <Button android:id="@+id/btnFse" style="@style/CalcButtonImageDark" android:text="FSE\nX ↔ E"/>
        <Button android:id="@+id/btnSigma" style="@style/CalcButtonImageDark" android:text="Π\nΣ"/>
        <Button android:id="@+id/btnDerivative" style="@style/CalcButtonImageDark" android:text="d/dx\n∫dx"/>
        <Button android:id="@+id/btnExtra1" style="@style/CalcButtonImageDark" android:text="" android:visibility="invisible"/>
        <Button android:id="@+id/btnExtra2" style="@style/CalcButtonImageDark" android:text="" android:visibility="invisible"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:orientation="horizontal">
        <Button android:id="@+id/btnPiHvpLabel" style="@style/CalcButtonImageDark" android:text="hyp\nπ"/>
        <Button android:id="@+id/btnSin" style="@style/CalcButtonImageDark" android:text="sin⁻¹\nsin"/>
        <Button android:id="@+id/btnCos" style="@style/CalcButtonImageDark" android:text="cos⁻¹\ncos"/>
        <Button android:id="@+id/btnTan" style="@style/CalcButtonImageDark" android:text="tan⁻¹\ntan"/>
        <Button android:id="@+id/btnImag" style="@style/CalcButtonImageDark" android:text="∠\ni"/>
        <Button android:id="@+id/btnLogBase" style="@style/CalcButtonImageDark" android:text="logₓy\neˣ"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:orientation="horizontal">
        <Button android:id="@+id/btnLim" style="@style/CalcButtonImageDark" android:text="lim\nx⁻¹"/>
        <Button android:id="@+id/btnPower" style="@style/CalcButtonImageDark" android:text="x³\nx²"/>
        <Button android:id="@+id/btnRoot" style="@style/CalcButtonImageDark" android:text="³√x\n√x"/>
        <Button android:id="@+id/btnRootIndex" style="@style/CalcButtonImageDark" android:text="∫√y\nxʲ"/>
        <Button android:id="@+id/btnTenPower" style="@style/CalcButtonImageDark" android:text="10ʲ\nlog₁₀"/>
        <Button android:id="@+id/btnNaturalLog" style="@style/CalcButtonImageDark" android:text="eʲ\nln"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:orientation="horizontal">
        <Button android:id="@+id/btnFrac" style="@style/CalcButtonImageDark" android:text="a b/c\nd/c"/>
        <Button android:id="@+id/btnVarX" style="@style/CalcButtonImageDark" android:text="Y\nX"/>
        <Button android:id="@+id/btnHistory" style="@style/CalcButtonImageDark" android:text="HISTORY\nXY,M"/>
        <Button android:id="@+id/btnMemoryPlus" style="@style/CalcButtonImageDark" android:text="M+\nMR"/>
        <Button android:id="@+id/btnMemoryMinus" style="@style/CalcButtonImageDark" android:text="M−\nx→M"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal">
        <Button android:id="@+id/btnVariable" style="@style/CalcButtonImageGray" android:text="a→z"/>
        <Button android:id="@+id/btnMc" style="@style/CalcButtonImageGray" android:text="MC"/>
        <Button android:id="@+id/btnPi" style="@style/CalcButtonImageGray" android:text="CONST
π"/>
    </LinearLayout>

    <Button android:id="@+id/btnChange" style="@style/CalcButtonImageGrayWide" android:text="D°M'S\nCHANGE" android:layout_width="match_parent" android:layout_height="66dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingTop="2dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn7" style="@style/CalcButtonImageDark" android:text="7"/>
            <Button android:id="@+id/btn8" style="@style/CalcButtonImageDark" android:text="8"/>
            <Button android:id="@+id/btn9" style="@style/CalcButtonImageDark" android:text="9"/>
            <Button android:id="@+id/btnOpenParen" style="@style/CalcButtonImageDark" android:text="n!\n("/>
            <Button android:id="@+id/btnCloseParen" style="@style/CalcButtonImageDark" android:text="nCr\n)"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn4" style="@style/CalcButtonImageDark" android:text="4"/>
            <Button android:id="@+id/btn5" style="@style/CalcButtonImageDark" android:text="5"/>
            <Button android:id="@+id/btn6" style="@style/CalcButtonImageDark" android:text="6"/>
            <Button android:id="@+id/btnMultiply" style="@style/CalcButtonImageDark" android:text="CNST\n×"/>
            <Button android:id="@+id/btnDivide" style="@style/CalcButtonImageDark" android:text="CONV\n÷"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn1" style="@style/CalcButtonImageDark" android:text="1"/>
            <Button android:id="@+id/btn2" style="@style/CalcButtonImageDark" android:text="2"/>
            <Button android:id="@+id/btn3" style="@style/CalcButtonImageDark" android:text="3"/>
            <Button android:id="@+id/btnPlus" style="@style/CalcButtonImageDark" android:text="OTHER\n+"/>
            <Button android:id="@+id/btnMinus" style="@style/CalcButtonImageDark" android:text="ran#\n−"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn0" style="@style/CalcButtonImageDark" android:text="0"/>
            <Button android:id="@+id/btnDot" style="@style/CalcButtonImageDark" android:text="."/>
            <Button android:id="@+id/btnSign" style="@style/CalcButtonImageDark" android:text="+/−"/>
            <Button android:id="@+id/btnExp" style="@style/CalcButtonImageDark" android:text="EXP"/>
            <Button android:id="@+id/btnEnter" style="@style/CalcButtonImageYellow" android:text="✓"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
