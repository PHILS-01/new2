<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#101010">
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="#1E1E1E" android:title="STATISTICS" android:titleTextColor="#F5F5F5"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
            <Spinner android:id="@+id/spinnerTool" android:layout_width="match_parent" android:layout_height="48dp"/>
            <TextView android:id="@+id/txtInstructions" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp" android:textColor="#AAAAAA" android:textSize="12sp"/>
            <LinearLayout android:id="@+id/tableControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
                <TextView android:id="@+id/txtTableSize" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#F5F5F5" android:text="6 × 6"/>
                <Button android:id="@+id/btnRowsMinus" android:layout_width="42dp" android:layout_height="42dp" android:text="−"/>
                <Button android:id="@+id/btnRowsPlus" android:layout_width="42dp" android:layout_height="42dp" android:text="+"/>
                <Button android:id="@+id/btnColsMinus" android:layout_width="42dp" android:layout_height="42dp" android:text="−"/>
                <Button android:id="@+id/btnColsPlus" android:layout_width="42dp" android:layout_height="42dp" android:text="+"/>
            </LinearLayout>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="horizontal">
                <LinearLayout android:id="@+id/tableContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:padding="2dp"/>
            </HorizontalScrollView>
            <LinearLayout android:id="@+id/rawGroupingControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
                <EditText android:id="@+id/editClassStart" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:hint="First class from" android:textColor="#F5F5F5" android:textColorHint="#AAAAAA" android:inputType="numberDecimal|numberSigned"/>
                <EditText android:id="@+id/editClassEnd" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:hint="First class to" android:textColor="#F5F5F5" android:textColorHint="#AAAAAA" android:inputType="numberDecimal|numberSigned"/>
            </LinearLayout>
            <EditText android:id="@+id/inputData" android:layout_width="match_parent" android:layout_height="120dp" android:gravity="top" android:hint="Input" android:textColor="#F5F5F5" android:textColorHint="#777777" android:inputType="textMultiLine"/>
            <CheckBox android:id="@+id/checkboxShowLabels" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Show axis labels" android:textColor="#F5F5F5" android:checked="true" android:visibility="gone"/>
            <Button android:id="@+id/btnRun" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:text="CALCULATE"/>
            <FrameLayout android:id="@+id/chartContainer" android:layout_width="match_parent" android:layout_height="480dp" android:visibility="gone"/>
            <TextView android:id="@+id/txtStatsResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp" android:textColor="#F5F5F5" android:textSize="15sp" android:fontFamily="monospace"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
