<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_dark"
        android:title="Answer Detail"
        app:titleTextColor="@color/text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Expression" android:textColor="@color/text_secondary" android:textSize="12sp"/>
        <TextView android:id="@+id/txtDetailExpr" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text_primary" android:textSize="20sp" android:layout_marginTop="4dp"
            android:textIsSelectable="true"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Result" android:textColor="@color/text_secondary" android:textSize="12sp"/>
        <TextView android:id="@+id/txtDetailResult" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/accent" android:textSize="34sp" android:textStyle="bold" android:layout_marginTop="4dp"
            android:textIsSelectable="true"/>

        <TextView android:id="@+id/txtDetailFractionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="As a fraction" android:textColor="@color/text_secondary" android:textSize="12sp"/>
        <TextView android:id="@+id/txtDetailFraction" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text_primary" android:textSize="18sp" android:layout_marginTop="4dp"
            android:textIsSelectable="true"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Angle mode" android:textColor="@color/text_secondary" android:textSize="12sp"/>
        <TextView android:id="@+id/txtDetailMode" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text_primary" android:textSize="16sp" android:layout_marginTop="4dp"/>

        <Button
            android:id="@+id/btnDetailCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Copy result" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
